# backend/.env に置く(全てKEIBA_プレフィックス)。秘密情報はコードへ埋め込まない。
KEIBA_KB_DIR=../KomaVault/05_Knowledge/占術知識ベース_v1.3
KEIBA_MANIFEST_MD=../正本参照.md
KEIBA_DATABASE_URL=sqlite:///./data/app.db
KEIBA_STRICT=0
KEIBA_DATA_PROVIDER=mock
KEIBA_DATA_PROVIDER_NAME=Mock Data Provider
KEIBA_DATA_PROVIDER_CREDIT=データ提供: モック(開発用固定データ)
KEIBA_DATA_PROVIDER_LICENSE_STATUS=development_only
# JRDB実データを使う場合(会員契約が必要。認証情報はコミット禁止)
# KEIBA_DATA_PROVIDER=jrdb
# KEIBA_DATA_PROVIDER_NAME=JRDB
# KEIBA_DATA_PROVIDER_CREDIT=データ提供: JRDB(個人利用契約)
# KEIBA_DATA_PROVIDER_LICENSE_STATUS=personal_use_only
# KEIBA_JRDB_DATA_DIR=./data/jrdb
# KEIBA_JRDB_BASE_URL=http://www.jrdb.com/member/data
# KEIBA_JRDB_USER=あなたの会員ID
# KEIBA_JRDB_PASSWORD=あなたのパスワード
KEIBA_FORBIDDEN_FILTER_MODE=reject
KEIBA_MASTER_33_ENABLED=1
KEIBA_CYCLE_MASTERS=1
KEIBA_AI_ENABLED=0
